{
  "name": "cloudflare-github-actions-runner",
  "version": "1.0.10",
  "description": "Run GitHub Actions jobs as disposable Cloudflare Containers.",
  "keywords": [
    "ci",
    "cloudflare",
    "containers",
    "github-actions",
    "self-hosted-runner"
  ],
  "homepage": "https://github.com/punkeel/cf-runners#readme",
  "bugs": {
    "url": "https://github.com/punkeel/cf-runners/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punkeel/cf-runners.git"
  },
  "files": [
    "docker",
    "scripts",
    "src",
    "cloudflare.config.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "cf workers types && vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "cf workers types && vp test",
    "deploy": "vp exec tsx scripts/deploy.ts",
    "deploy:dry-run": "vp exec tsx scripts/deploy.ts --dry-run",
    "resource-traces": "vp exec tsx scripts/resource-metrics.ts",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "vp pack",
    "prepublishOnly": "vp check && vp test"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "tsx": "^4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/config": "^0.28.1",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.5",
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^26.2.0",
    "cf": "1.0.0-beta.24",
    "oxlint": "1.78.0",
    "typescript": "^5.9.3",
    "vite": "7.1.12",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.154.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  }
}
